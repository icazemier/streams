{
    "name": "@icazemier/streams",
    "author": "I.Cazemier <git@warmemelk.nl>",
    "version": "1.0.0",
    "description": "Experiment with the Node.js Streams API",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "types": "./dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "npm run clean && tsc -p .",
        "clean": "rm -rf ./dist",
        "start": "npm run build && node dist/index.js",
        "start:stream-big-file-front-end": "npm run build && node dist/examples/video/stream-big-file-front-end/index.js",
        "start:profile": "npm run build && clinic doctor -- node ./dist/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.5",
        "@types/node": "^24.13.3",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "csv-stringify": "^6.2.0",
        "express": "^5.2.1",
        "jszip": "^3.10.1",
        "pretty-ms": "^8.0.0",
        "winston": "^3.8.2"
    }
}
